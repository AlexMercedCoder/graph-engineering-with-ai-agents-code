{"id": 1, "hops": "single", "q": "What does NotificationsService store, and where?", "expect": ["queue", "redis"], "support": ["notifications-service#Data"], "labels": ["queued messages", "the notifications Redis instance"]}
{"id": 2, "hops": "single", "q": "What are the NotificationsAPI retry semantics?", "expect": ["\\b(three|3)\\b[^.\\n]{0,20}attempt", "250\\s*ms"], "support": ["notifications-service#Delivery and retries"], "labels": ["three attempts", "a 250 ms backoff"]}
{"id": 3, "hops": "single", "q": "Which database does OrderService use?", "expect": ["orders?\\b[^.\\n]{0,30}postgres|orderspostgres"], "support": ["order-service#Data"], "labels": ["the orders Postgres database"]}
{"id": 4, "hops": "single", "q": "Where does AuditService store its records?", "expect": ["iceberg"], "support": ["audit-service#Data"], "labels": ["the audit Iceberg table"]}
{"id": 5, "hops": "single", "q": "Which configuration key sets the PaymentsService capture timeout, and what is its default?", "expect": ["CAPTURE_TIMEOUT", "\\b30\\b"], "support": ["payments-service#Configuration"], "labels": ["CAPTURE_TIMEOUT", "a default of 30 seconds"]}
{"id": 6, "hops": "single", "q": "What does AuditService depend on for identity resolution?", "expect": ["users?\\s*-?\\s*service"], "support": ["audit-service#Integrations"], "labels": ["UserService"]}
{"id": 7, "hops": "single", "q": "Where does SearchService keep its index?", "expect": ["opensearch"], "support": ["search-service#Data"], "labels": ["the search OpenSearch cluster"]}
{"id": 8, "hops": "single", "q": "What does ApiGateway use for token validation?", "expect": ["users?\\s*-?\\s*service"], "support": ["api-gateway#Integrations"], "labels": ["UserService"]}
{"id": 9, "hops": "single", "q": "How often does RenewalsWorker re-bill subscriptions?", "expect": ["monthly|each month|every month|first of"], "support": ["renewals-worker#Overview"], "labels": ["monthly"]}
{"id": 10, "hops": "single", "q": "Which configuration key does UserService use for its read replica?", "expect": ["ORDER_DB_URL"], "support": ["user-service#Configuration"], "labels": ["ORDER_DB_URL"]}
{"id": 11, "hops": "multi", "q": "If the NotificationsAPI changes its retry semantics, which services are affected within two hops? Count services that call it, then services that depend on those or call their APIs.", "expect": ["billing\\s*-?\\s*service", "payments?\\s*-?\\s*service", "renewals?\\s*-?\\s*worker", "reporting\\s*-?\\s*service", "orders?\\s*-?\\s*service"], "labels": ["BillingService", "PaymentsService", "RenewalsWorker", "ReportingService", "OrderService"], "support": ["billing-service#Integrations", "payments-service#Integrations", "renewals-worker#Integrations", "reporting-service#Integrations", "order-service#Integrations", "payments-service#Overview"], "closed": true}
{"id": 12, "hops": "multi", "q": "If BillingService goes down, which services stop working within two hops? Count services that depend on it or call its API, then services that depend on those.", "expect": ["reporting\\s*-?\\s*service", "renewals?\\s*-?\\s*worker"], "labels": ["ReportingService", "RenewalsWorker"], "support": ["renewals-worker#Integrations", "reporting-service#Integrations"], "closed": true}
{"id": 13, "hops": "multi", "q": "What does OrderService need in order to run, within two hops? Count the APIs it calls and the service behind each, the services it depends on, and the databases it stores data in, then the same for each of those.", "expect": ["orders?\\b[^.\\n]{0,30}postgres|orderspostgres", "payments\\s*-?\\s*api", "payments?\\s*-?\\s*service", "users?\\s*-?\\s*service", "notifications\\s*-?\\s*api", "notifications?\\s*-?\\s*service", "payments?\\b[^.\\n]{0,30}postgres|paymentspostgres", "users?\\b[^.\\n]{0,30}postgres|userspostgres"], "labels": ["the orders Postgres database", "PaymentsAPI", "PaymentsService", "UserService", "NotificationsAPI", "NotificationsService", "the payments Postgres database", "the users Postgres database"], "support": ["order-service#Integrations", "order-service#Data", "payments-service#Overview", "payments-service#Integrations", "payments-service#Data", "notifications-service#Overview", "user-service#Data"], "closed": true}
{"id": 14, "hops": "multi", "q": "If the notifications Redis instance is lost, which services that call the NotificationsAPI directly can no longer get their messages delivered?", "expect": ["billing\\s*-?\\s*service", "payments?\\s*-?\\s*service"], "labels": ["BillingService", "PaymentsService"], "support": ["notifications-service#Overview", "notifications-service#Data", "billing-service#Integrations", "payments-service#Integrations"], "closed": true}
{"id": 15, "hops": "multi", "q": "If UserService goes down, which services are affected within two hops? Count services that depend on it or call its API, then services that depend on those or call their APIs.", "expect": ["api\\s*-?\\s*gateway", "audit\\s*-?\\s*service", "orders?\\s*-?\\s*service", "billing\\s*-?\\s*service", "reporting\\s*-?\\s*service", "search\\s*-?\\s*service"], "labels": ["ApiGateway", "AuditService", "OrderService", "BillingService", "ReportingService", "SearchService"], "support": ["api-gateway#Integrations", "audit-service#Integrations", "order-service#Integrations", "billing-service#Integrations", "reporting-service#Integrations", "search-service#Integrations"], "closed": true}
{"id": 16, "hops": "multi", "q": "Which services call the PaymentsAPI directly?", "expect": ["orders?\\s*-?\\s*service", "renewals?\\s*-?\\s*worker"], "labels": ["OrderService", "RenewalsWorker"], "support": ["order-service#Integrations", "renewals-worker#Integrations"], "closed": true}
{"id": 17, "hops": "multi", "q": "If OrderService changes its line-item format, which services are affected within two hops? Count services that depend on it or call its API, then services that depend on those.", "expect": ["billing\\s*-?\\s*service", "reporting\\s*-?\\s*service", "search\\s*-?\\s*service", "api\\s*-?\\s*gateway", "renewals?\\s*-?\\s*worker"], "labels": ["BillingService", "ReportingService", "SearchService", "ApiGateway", "RenewalsWorker"], "support": ["billing-service#Integrations", "reporting-service#Integrations", "search-service#Integrations", "api-gateway#Integrations", "order-service#Overview", "renewals-worker#Integrations"], "closed": true}

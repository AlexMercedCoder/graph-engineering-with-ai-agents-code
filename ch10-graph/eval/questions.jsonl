{"id": 19, "hops": "multi", "q": "If PaymentsService is down, which services that call its API directly can no longer take payments?", "expect": ["orders?\\s*-?\\s*service", "renewals?\\s*-?\\s*worker"], "labels": ["OrderService", "RenewalsWorker"], "support": ["payments-service#Overview", "order-service#Integrations", "renewals-worker#Integrations"], "closed": true}

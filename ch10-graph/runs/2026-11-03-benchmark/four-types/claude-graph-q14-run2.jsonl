 NotificationsAPI in the graph."}], "container": null, "stop_reason": null, "stop_sequence": null, "stop_details": null, "usage": {"input_tokens": 2, "cache_creation_input_tokens": 441, "cache_read_input_tokens": 6306, "cache_creation": {"ephemeral_5m_input_tokens": 0, "ephemeral_1h_input_tokens": 441}, "output_tokens": 8, "service_tier": "standard", "inference_geo": "global", "speed": "standard"}, "input_transformations": [], "diagnostics": null, "context_management": null}, "parent_tool_use_id": null, "session_id": "c00d9a0d-7ccc-4f16-a257-bd33cb72117b", "uuid": "ff020d84-21bb-48e8-915a-d92473995cd1", "timestamp": "2026-11-04T02:25:43.650Z", "request_id": "req_011Cgh6VGnNvMzeMPkpttGjD"}

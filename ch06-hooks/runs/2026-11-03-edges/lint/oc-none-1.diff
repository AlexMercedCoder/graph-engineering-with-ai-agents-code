 import { test } from 'node:test';
 import assert from 'node:assert/strict';
-import { findByEmail, isActive } from '../src/services/auth-service.js';
+import { findByEmail, isActive, recordLogin } from '../src/services/auth-service.js';
+import { query } from '../src/db.js';
 
 test('findByEmail ignores soft-deleted users', (t, done) => {
   findByEmail('alan@example.com', (err, user) => {
@@ -17,3 +18,38 @@ test('isActive is true for a live user', (t, done) => {
     done();
   });
 });
+
+test('recordLogin persists the current time for an active user', (t, done) => {
+  const startedAt = Date.now();
+  recordLogin('ada@example.com', (err, user) => {
+    assert.equal(err, null);
+    assert.equal(user.email, 'ada@example.com');
+    const recordedAt = Date.parse(user.last_login_at);
+    assert.ok(recordedAt >= startedAt && recordedAt <= Date.now());
+    findByEmail('ada@example.com', (err, storedUser) => {
+      assert.equal(err, null);
+      assert.equal(storedUser.last_login_at, user.last_login_at);
+      done();
+    });
+  });
+});
+
+test('recordLogin does not update a soft-deleted user', (t, done) => {
+  recordLogin('alan@example.com', (err, user) => {
+    assert.equal(err, null);
+    assert.equal(user, null);
+    query('users', (u) => u.email === 'alan@example.com', (err, rows) => {
+      assert.equal(err, null);
+      assert.equal(rows[0].last_login_at, undefined);
+      done();
+    });
+  });
+});
+
+test('recordLogin returns null for a missing user', (t, done) => {
+  recordLogin('missing@example.com', (err, user) => {
+    assert.equal(err, null);
+    assert.equal(user, null);
+    done();
+  });
+});

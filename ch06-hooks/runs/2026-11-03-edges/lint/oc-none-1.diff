diff --git a/src/services/auth-service.js b/src/services/auth-service.js
index 9a683b0..fe82c4f 100644
--- a/src/services/auth-service.js
+++ b/src/services/auth-service.js
@@ -1,4 +1,4 @@
-import { query } from '../db.js';
+import { query, update } from '../db.js';
 
 // Callback-style database access. Chapter 5 migrates this to UserRepository.
 export function findByEmail(email, callback) {
@@ -14,3 +14,11 @@ export function isActive(email, callback) {
     callback(null, Boolean(user));
   });
 }
+
+export function recordLogin(email, callback) {
+  findByEmail(email, (err, user) => {
+    if (err) return callback(err);
+    if (!user) return callback(null, null);
+    update('users', user.id, { last_login_at: new Date().toISOString() }, callback);
+  });
+}
diff --git a/tests/auth-service.test.js b/tests/auth-service.test.js

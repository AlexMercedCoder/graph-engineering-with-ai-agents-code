+
+// Sets last_login_at to now on the active user with this email.
+// Calls back with the updated user, or null if no active user has that email.
+export function recordLogin(email, callback) {
+  findByEmail(email, (err, user) => {
+    if (err) return callback(err);
+    if (!user) return callback(null, null);
+    users.setLastLogin(user.id, new Date().toISOString())
+      .then((updated) => callback(null, updated), callback);
+  });
+}

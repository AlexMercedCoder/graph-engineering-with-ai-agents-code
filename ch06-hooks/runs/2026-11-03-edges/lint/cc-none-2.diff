+
+test('recordLogin sets last_login_at to now on the active user', (t, done) => {
+  const before = Date.now();
+  recordLogin('grace@example.com', (err, user) => {
+    assert.equal(err, null);
+    assert.equal(user.email, 'grace@example.com');
+    const stamped = Date.parse(user.last_login_at);
+    assert.ok(stamped >= before && stamped <= Date.now());
+    findByEmail('grace@example.com', (err2, stored) => {
+      assert.equal(err2, null);
+      assert.equal(stored.last_login_at, user.last_login_at);
+      done();
+    });
+  });
+});
+
+test('recordLogin skips soft-deleted users', (t, done) => {
+  recordLogin('alan@example.com', (err, user) => {
+    assert.equal(err, null);
+    assert.equal(user, null);
+    done();
+  });
+});

-import { query } from '../db.js';
+import { UserRepository } from '../repositories/user-repository.js';
+
+// Callback-style API kept for existing callers; data access goes through
+// UserRepository.
+const users = new UserRepository();
+
+// Adapts a promise to a Node-style callback. The callback runs outside the
+// promise chain so an exception it throws is not caught and fed back in.
+function toCallback(promise, callback) {
+  promise.then(
+    (value) => process.nextTick(callback, null, value),
+    (err) => process.nextTick(callback, err),
+  );
+}
 
-// Callback-style database access. Chapter 5 migrates this to UserRepository.
 export function findByEmail(email, callback) {
-  query('users', (u) => u.email === email && u.deleted_at === null, (err, rows) => {
-    if (err) return callback(err);
-    callback(null, rows[0] ?? null);
-  });
+  toCallback(users.findActiveByEmail(email), callback);
 }
 
 export function isActive(email, callback) {
@@ -14,3 +23,11 @@ export function isActive(email, callback) {
     callback(null, Boolean(user));
   });
 }
+
+// Stamps last_login_at on the active user with this email.
+// Calls back with the updated user, or null if no active user matches.
+export function recordLogin(email, callback) {
+  const stamped = users.findActiveByEmail(email).then((user) =>
+    (user ? users.recordLogin(user.id, new Date().toISOString()) : null));
+  toCallback(stamped, callback);
+}

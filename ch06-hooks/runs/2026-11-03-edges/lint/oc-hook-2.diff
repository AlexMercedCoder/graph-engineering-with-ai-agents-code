+
+test('recordLogin persists the current time for an active user', (t, done) => {
+  const before = Date.now();
+  recordLogin('ada@example.com', (err, user) => {
+    assert.equal(err, null);
+    assert.equal(user.email, 'ada@example.com');
+    const timestamp = Date.parse(user.last_login_at);
+    assert.ok(timestamp >= before && timestamp <= Date.now());
+    findByEmail('ada@example.com', (findErr, savedUser) => {
+      assert.equal(findErr, null);
+      assert.equal(savedUser.last_login_at, user.last_login_at);
+      done();
+    });
+  });
+});
+
+test('recordLogin does not update a soft-deleted user', (t, done) => {
+  query('users', (u) => u.email === 'alan@example.com', (queryErr, rows) => {
+    assert.equal(queryErr, null);
+    const original = rows[0];
+    recordLogin('alan@example.com', (err, user) => {
+      assert.equal(err, null);
+      assert.equal(user, null);
+      query('users', (u) => u.id === original.id, (findErr, savedRows) => {
+        assert.equal(findErr, null);
+        assert.deepEqual(savedRows[0], original);
+        done();
+      });
+    });
+  });
+});
+
+test('recordLogin returns null for an unknown email', (t, done) => {
+  recordLogin('unknown@example.com', (err, user) => {
+    assert.equal(err, null);
+    assert.equal(user, null);
+    done();
+  });

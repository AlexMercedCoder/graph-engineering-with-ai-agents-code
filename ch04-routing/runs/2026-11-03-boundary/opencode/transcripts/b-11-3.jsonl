ort function findPaymentsForOrder(orderId, callback) {\n  query('payments', (p) => p.order_id === orderId, callback);\n}\n\nexport function uncapturedTotalCents(callback) {\n  query('payments', (p) => p.captured === false, (err, rows) => {\n    if (err) return callback(err);\n    callback(null, rows.reduce((sum, p) => sum + p.amount_cents, 0));\n  });\n}", "lineStart": 1, "lineEnd": 14, "totalLines": 14, "truncated": false}}, "title": "src/services/payment-service.js", "time": {"start": 1793721313827, "end": 1793721313848}}, "metadata": {"openai": {"itemId": "fc_07e40a053cdfa635016aea03e1ba78819e81c13189cd129b16"}}, "id": "prt_1a21f2a190014qzJIyhxbsJQLu", "sessionID": "ses_e5de0eb15ffetwz4tme8nIBp5m", "messageID": "msg_1a21f2042001esmcUuAT2DGmk8"}}

diff --git a/src/repositories/payment-repository.js b/src/repositories/payment-repository.js
new file mode 100644
index 0000000..ff473ee
--- /dev/null
+++ b/src/repositories/payment-repository.js
@@ -0,0 +1,17 @@
+import { query } from '../db.js';
+
+export class PaymentRepository {
+  findByOrder(orderId) {
+    return new Promise((resolve, reject) => {
+      query('payments', (p) => p.order_id === orderId,
+        (err, rows) => (err ? reject(err) : resolve(rows)));
+    });
+  }
+
+  findUncaptured() {
+    return new Promise((resolve, reject) => {
+      query('payments', (p) => p.captured === false,
+        (err, rows) => (err ? reject(err) : resolve(rows)));
+    });
+  }
+}

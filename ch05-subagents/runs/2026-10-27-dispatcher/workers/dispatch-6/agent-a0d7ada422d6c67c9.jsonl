onst row = (tables[table] || []).find((r) => r.id === id);\n43\t    if (!row) return callback(new Error(`no row ${id} in ${table}`));\n44\t    Object.assign(row, patch);\n45\t    callback(null, { ...row });\n46\t  });\n47\t}\n48\t"}]}, "uuid": "4a6fbf77-1087-4476-bebc-94cc1c0b3f82", "timestamp": "2026-10-27T14:42:40.312Z", "sourceToolAssistantUUID": "dff7246f-fc0b-4c06-b2c5-a3ec56d34d8c", "permissionDecision": {"decision": "accept", "source": "config", "reasonType": "mode"}, "userType": "external", "entrypoint": "sdk-cli", "cwd": "<run-dir>", "sessionId": "3a7c6801-a4ec-4608-a280-fa00561a402a", "version": "2.1.308", "gitBranch": "main"}

}\n  });\n  if (!outcome.ok) broken += 1;\n  console.log(`${outcome.ok ? 'ok  ' : 'FAIL'}  ${route.method} ${route.path} -> ${outcome.text}`);\n}\n\nconsole.log(broken ? `${broken} of ${routes.length} routes broken` : `all ${routes.length} routes respond`);\nprocess.exit(broken ? 1 : 0);", "is_error": false}]}, "uuid": "d981df45-f01f-4632-a6dc-4ae4f00d1817", "timestamp": "2026-10-27T15:46:47.154Z", "sandboxed": false, "sourceToolAssistantUUID": "8f502217-e3b5-42c8-93d2-14bf96c26a01", "permissionDecision": {"decision": "accept", "source": "config", "reasonType": "subcommandResults"}, "userType": "external", "entrypoint": "sdk-cli", "cwd": "<run-dir>", "sessionId": "d02546af-6d82-43d7-8d25-546bc497671b", "version": "2.1.308", "gitBranch": "main"}

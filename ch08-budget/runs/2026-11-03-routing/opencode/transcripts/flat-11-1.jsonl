) {\n  query('payments', (p) => p.order_id === orderId, callback);\n}\n\nexport function uncapturedTotalCents(callback) {\n  query('payments', (p) => p.captured === false, (err, rows) => {\n    if (err) return callback(err);\n    callback(null, rows.reduce((sum, p) => sum + p.amount_cents, 0));\n  });\n}", "lineStart": 1, "lineEnd": 14, "totalLines": 14, "truncated": false}}, "title": "src/services/payment-service.js", "time": {"start": 1793725550325, "end": 1793725550345}}, "metadata": {"openai": {"itemId": "fc_093ef750e334f683016aea146e2b548197904cc4befd0d9fa6"}}, "id": "prt_1a25fceec001S0hTeOU7ENqOjb", "sessionID": "ses_e5da05559ffedRph3NUG49TmDe", "messageID": "msg_1a25fbdeb001W6j3Z36EA7tAvQ"}}

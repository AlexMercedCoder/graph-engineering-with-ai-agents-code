+++ b/AGENTS.md
@@ -0,0 +1,8 @@
+# Project Rules
+
+## Database access
+
+All database access goes through the repository classes in `src/repositories/`.
+
+- Code in `src/services/` must **never** import `query()` or `update()` from `src/db.js`.
+- Use `UserRepository` and `OrderRepository` for all data operations.
diff --git a/src/services/order-service.js b/src/services/order-service.js
index 12cb020..10c5849 100644
--- a/src/services/order-service.js
+++ b/src/services/order-service.js
@@ -1,13 +1,21 @@
-import { query } from '../db.js';
+import { OrderRepository } from '../repositories/order-repository.js';
+import { UserRepository } from '../repositories/user-repository.js';
 
-// Callback-style database access. Chapter 5 migrates this to OrderRepository.
-export function listOrdersForUser(userId, callback) {
-  query('orders', (o) => o.user_id === userId && o.deleted_at === null, callback);
+const orders = new OrderRepository();
+const users = new UserRepository();
+
+export function listOrdersForUser(userId) {
+  return orders.findByUser(userId);
 }
 
-export function totalPaidCents(callback) {
-  query('orders', (o) => o.status === 'paid' && o.deleted_at === null, (err, rows) => {
-    if (err) return callback(err);
-    callback(null, rows.reduce((sum, o) => sum + o.total_cents, 0));
-  });
+export async function totalPaidCents() {
+  const [paid, activeUsers] = await Promise.all([
+    orders.findPaid(),
+    users.findActive(),
+  ]);
+  const activeIds = new Set(activeUsers.map((u) => u.id));
+  return paid.reduce(
+    (sum, o) => (activeIds.has(o.user_id) ? sum + o.total_cents : sum),
+    0,
+  );
 }

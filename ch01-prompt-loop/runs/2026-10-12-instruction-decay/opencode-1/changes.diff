diff --git a/tests/user-soft-delete.test.js b/tests/user-soft-delete.test.js
new file mode 100644
index 0000000..ea40e78
--- /dev/null
+++ b/tests/user-soft-delete.test.js
@@ -0,0 +1,10 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { listActiveUsers, softDeleteUser } from '../src/services/user-service.js';
+
+test('softDeleteUser removes a user from the active list', async () => {
+  await softDeleteUser(2, '2026-02-01');
+  const users = await listActiveUsers();
+  assert.equal(users.length, 1);
+  assert.ok(users.every((u) => u.id !== 2));
+});
